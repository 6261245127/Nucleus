generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  CREATOR
  ADMIN
}

enum CampaignStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  VERIFIED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TASK_REWARD
  REFERRAL_REWARD
  BONUS_REWARD
  CAMPAIGN_PAYMENT
  ADMIN_ADJUSTMENT
}

enum WithdrawalStatus {
  PENDING
  REVIEW
  APPROVED
  PAID
  REJECTED
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserAccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  name         String
  role         Role     @default(VIEWER)
  isVerified   Boolean  @default(false)
  accountStatus UserAccountStatus @default(ACTIVE)
  lastLogin    DateTime?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  niches              String[] @default([])
  preferences         Json?
  onboardingCompleted Boolean  @default(false)
  signupBonusAwarded  Boolean  @default(false)

  // Relations
  wallet         Wallet?
  userStat       UserStat?
  campaigns      Campaign[]
  tasksCompleted Task[]
  referralsMade  Referral[]     @relation("Referrer")
  referralsUsed  Referral[]     @relation("Referred")
  withdrawals    Withdrawal[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  auditLogsTargeted AuditLog[] @relation("TargetUser")
  subscription   Subscription?

  @@index([role])
}

model UserStat {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastTaskDate    DateTime?
  level           Int      @default(1)
  totalTasks      Int      @default(0)
}

model Subscription {
  id        String           @id @default(uuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      SubscriptionTier @default(STARTER)
  isActive  Boolean          @default(true)
  expiresAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinBalance   Float    @default(0) // For Viewers earning coins
  fiatBalance   Float    @default(0) // For Creators funding campaigns (e.g. USD or INR)
  rewardBalance Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions Transaction[]
}

model Transaction {
  id          String          @id @default(uuid())
  walletId    String
  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float
  type        TransactionType
  referenceId String? // e.g. Task ID, Campaign ID, Withdrawal ID
  description String?
  createdAt   DateTime        @default(now())

  @@index([walletId, createdAt(sort: Desc)])
}

model Campaign {
  id            String         @id @default(uuid())
  creatorId     String
  creator       User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name          String
  platform      String // e.g. INSTAGRAM, FACEBOOK, YOUTUBE, THREADS
  url           String
  description   String?
  budget        Float
  rewardPerTask Float
  durationDays   Int      @default(7)
  niche          String   @default("General")
  adminStartDate DateTime?
  adminEndDate   DateTime?
  status        CampaignStatus @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tasks Task[]

  @@index([status, creatorId])
}

model Task {
  id           String     @id @default(uuid())
  campaignId   String
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  viewerId     String
  viewer       User       @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  status       TaskStatus @default(PENDING)
  rewardAmount Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([viewerId, status])
  @@index([campaignId])
}

model Referral {
  id           String   @id @default(uuid())
  referrerId   String
  referrer     User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId   String?  @unique // A user can only be referred once
  referred     User?    @relation("Referred", fields: [referredId], references: [id], onDelete: SetNull)
  code         String   @unique
  rewardEarned Float    @default(0)
  status       String   @default("PENDING") // e.g., PENDING, COMPLETED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Withdrawal {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  method    String // e.g. UPI, BANK_TRANSFER, PAYPAL
  details   Json // Store account details securely
  status    WithdrawalStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String // e.g. SYSTEM, REWARD, CAMPAIGN_APPROVAL
  createdAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?    @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String
  resource     String
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
}

model CMSSetting {
  id            String   @id @default("global-settings")
  websiteName   String   @default("The Social Bite")
  logoUrl       String?
  faviconUrl    String?
  websiteUrl    String?
  supportEmail  String?
  contactNumber String?
  socialLinks   Json?    // { twitter: "...", instagram: "...", youtube: "..." }
  copyrightText String   @default("© 2026 The Social Bite Inc. All rights reserved.")
  updatedAt     DateTime @updatedAt
}

model CMSSection {
  id        String   @id @default(uuid())
  type      String   // HERO, TRUST, HOW_IT_WORKS, FEATURES, AI_RECOMMENDATIONS, CREATOR_SHOWCASE, MARKETPLACE_PREVIEW, EARNINGS, TESTIMONIALS, PRICING, FAQ, FINAL_CTA
  title     String?
  subtitle  String?
  content   Json     // stores JSON containing section-specific fields
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CMSMedia {
  id        String   @id @default(uuid())
  name      String
  url       String   // e.g. /uploads/image.png
  mimeType  String?
  size      Int?
  category  String?  // LOGO, FAVICON, HERO, FEATURE, CREATOR, BACKGROUND, BANNER, FOOTER, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CMSPricingPlan {
  id         String   @id @default(uuid())
  name       String
  price      Float
  currency   String   @default("INR")
  period     String?  @default("/mo")
  features   String[] @default([])
  badgeLabel String?
  buttonText String   @default("Get Started")
  isPopular  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CMSMenuItem {
  id        String   @id @default(uuid())
  menuType  String   // HEADER, FOOTER, SIDEBAR
  title     String
  url       String
  icon      String?
  order     Int      @default(0)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CMSTestimonial {
  id        String   @id @default(uuid())
  name      String
  role      String
  company   String?
  image     String?
  review    String
  rating    Int      @default(5)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CMSFaq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CMSPageSeo {
  id              String   @id @default(uuid())
  pagePath        String   @unique
  metaTitle       String
  metaDescription String
  ogTitle         String?
  ogDescription   String?
  keywords        String?
  ogImage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CMSAnnouncement {
  id        String   @id @default(uuid())
  message   String
  link      String?
  isActive  Boolean  @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
